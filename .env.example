# ---------------------------------------------------------------------------
# Build (npm run build)
# ---------------------------------------------------------------------------
# Production address, https only. Enables canonicals, sitemap, og:image and
# structured data. Leave empty for a local build.
SITE_ORIGIN=https://www.bouwvast.nl
# Set to false on staging/preview: every page noindex + robots.txt Disallow.
SITE_INDEXING=true
# Offer the /werkgebied/<plaats>/ pages to search engines. Keep false until
# each page has genuine local content (projects, photos, reviews).
INDEX_CITY_PAGES=false
# Lead endpoint used by the browser (also set in .env.production).
VITE_LEAD_ENDPOINT=/api/leads

# ---------------------------------------------------------------------------
# Server (npm start)
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Where leads and photos are stored. Must be persistent (a volume), backed up,
# and readable only by the server.
DATA_DIR=./data
# Behind a reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=false
# Send Strict-Transport-Security (defaults to true when SITE_ORIGIN is https).
HSTS=true
# Extra origins allowed to POST leads, comma separated (e.g. staging).
LEAD_ALLOWED_ORIGINS=
# Per-IP limit: max requests per window.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=600
# Must match LEGAL.leadRetentionMonths in src/data/legal.ts.
LEAD_RETENTION_DAYS=365

# Notification: configure at least one channel, otherwise nobody hears
# about new leads. Unsent notifications are retried every
# LEAD_NOTIFY_RETRY_SECONDS.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM="Bouwvast website <website@bouwvast.nl>"
LEAD_NOTIFY_RETRY_SECONDS=300
