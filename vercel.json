{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/leads",
      "destination": "/api/leads"
    },
    {
      "source": "/healthz",
      "destination": "/api/healthz"
    }
  ]
}
