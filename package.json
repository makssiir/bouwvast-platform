{
  "name": "bouwvast-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node --env-file-if-exists=.env scripts/prerender.mjs",
    "build:client": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "npm run build && npm start",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "verify:leads": "node scripts/verify-leads.ts",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "check:launch": "node --env-file-if-exists=.env scripts/check-launch.mjs",
    "release:check": "npm run typecheck && npm run verify:leads && npm run build && npm run verify:routes"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
